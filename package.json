{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:ssr": "vite build --ssr",
        "prebuild": "npm run ziggy",
        "predev": "npm run ziggy",
        "dev": "vite",
        "lint": "eslint resources/ts --max-warnings=0",
        "format": "prettier --write \"resources/ts/**/*.{ts,tsx,css,scss}\"",
        "format:check": "prettier --check \"resources/ts/**/*.{ts,tsx,css,scss}\"",
        "ziggy": "php artisan ziggy:generate resources/ts/utils/ziggy --types && mv resources/ts/utils/ziggy.d.ts resources/ts/types/ziggy.d.ts && mv resources/ts/utils/ziggy.js resources/ts/utils/ziggy.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "sass": "^1.105.0",
        "tailwindcss": "^3.4.19",
        "typescript": "~5.9",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.1",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-hover-card": "^1.1.23",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.47.0",
        "react": "^19.3.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.3.0",
        "react-ga4": "^3.0.1",
        "tailwind-merge": "^3.7.0",
        "ziggy-js": "^2.6.4",
        "zustand": "^5.0.15"
    }
}
